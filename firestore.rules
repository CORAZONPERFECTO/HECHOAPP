rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función básica para verificar autenticación
    function isAuth() {
      return request.auth != null;
    }
    
    // Obtener rol del usuario (hace 1 read en servidor)
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc == null ? null : (userDoc.data.rol != null ? userDoc.data.rol : userDoc.data.role);
    }

    // Obtener las ubicaciones asignadas al gestor
    function getAssignedLocations() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data.assignedLocations != null ? userDoc.data.assignedLocations : [];
    }

    // Obtener el ID de cliente (tenant) asociado al usuario
    function getUserClientId() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc == null ? null : userDoc.data.clientId;
    }

    // Comprobar si es un rol gerencial o admin
    function isManager() {
      let role = getUserRole();
      return isAuth() && (
        (request.auth.token.email != null && request.auth.token.email == 'lcaa27@gmail.com') ||
        role == 'ADMIN' || 
        role == 'GERENTE' || 
        role == 'GERENTE_TICKETS' || 
        role == 'SUPERVISOR'
      );
    }

    // Comprobar si es personal interno (incluyendo técnicos)
    function isStaff() {
      let role = getUserRole();
      return isAuth() && (
        (request.auth.token.email != null && request.auth.token.email == 'lcaa27@gmail.com') ||
        role == 'ADMIN' || 
        role == 'GERENTE' || 
        role == 'GERENTE_TICKETS' || 
        role == 'SUPERVISOR' ||
        role == 'TECNICO' ||
        role == 'CONTRATISTA'
      );
    }

    // 1) REGLAS DE SEGURIDAD ESTRICTA: Colección de Usuarios
    // Impide que un TECNICO (o cualquier rol no admin) lea o modifique perfiles de otros
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isManager());
      allow create: if isAuth() && isManager();
      allow delete: if isAuth() && isManager();
      allow update: if isAuth() && (
        isManager() || 
        (
          request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'clientId', 'assignedLocations', 'activo', 'allowVideoUpload']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['allowedDeviceIds']) ||
            (
              request.resource.data.allowedDeviceIds.size() <= 2 &&
              request.resource.data.allowedDeviceIds.hasAll(resource.data.get('allowedDeviceIds', []))
            )
          )
        )
      );
      
      // Permitir acceso a subcolecciones (ej. notificaciones) solo al dueño o admin
      match /{document=**} {
        allow read: if isAuth() && (request.auth.uid == userId || isManager());
        allow write: if isAuth() && (request.auth.uid == userId || isManager());
      }
    }

    // 2) REGLAS DE SEGURIDAD ESTRICTA: Colección de Recursos/Personal
    // Impide que un TECNICO vea los documentos sensibles de otros empleados
    match /personnel/{personnelId} {
      allow read: if isAuth() && (isManager() || (resource != null && resource.data.userId == request.auth.uid));
      allow write: if isAuth() && (isManager() || (
        (request.method == 'create' && request.resource.data.userId == request.auth.uid) || 
        (request.method != 'create' && resource != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
      ));
    }
    
    // 3) CATÁLOGO DE PRODUCTOS E INVENTARIO
    // Solo gerentes/admin pueden crear o modificar productos y ubicaciones (almacenes/camionetas)
    match /inventory_products/{productId} {
      allow read: if isAuth();
      allow write: if isManager();
    }
    
    match /inventory_locations/{locationId} {
      allow read: if isAuth();
      allow write: if isManager();
    }
    
    // El stock y alertas son modificados por los técnicos al consumir materiales en transacciones
    match /inventory_stock/{stockId} {
      allow read: if isAuth();
      allow write: if isStaff();
    }
    
    match /inventory_alerts/{alertId} {
      allow read: if isAuth();
      allow write: if isStaff();
    }
    
    // Los movimientos pueden ser creados por técnicos, pero nunca modificados ni eliminados por ellos
    match /inventory_movements/{movementId} {
      allow read: if isAuth();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }
    
    // 4) TICKETS Y SUBCOLECCIONES
    // Acceso restringido según el rol del usuario (Administración, Técnico Asignado, Cliente Propietario o Gestor de Villa)
    match /tickets/{ticketId} {
      allow read: if isAuth() && (
        isManager() || 
        (resource != null && (
          resource.data.technicianId == request.auth.uid || 
          resource.data.tecnicoAsignadoId == request.auth.uid ||
          (resource.data.clientId != null && resource.data.clientId == getUserClientId()) ||
          (resource.data.locationId != null && resource.data.locationId in getAssignedLocations()) ||
          (resource.data.villaId != null && resource.data.villaId in getAssignedLocations())
        ))
      );
      allow create: if isManager();
      allow update: if isManager() || (isAuth() && (
        resource.data.technicianId == request.auth.uid || 
        resource.data.tecnicoAsignadoId == request.auth.uid
      ));
      allow delete: if isManager();
      
      match /{document=**} {
        allow read: if isAuth() && (
          isManager() || 
          (
            let parentTicketDoc = get(/databases/$(database)/documents/tickets/$(ticketId));
            parentTicketDoc != null && (
              parentTicketDoc.data.technicianId == request.auth.uid || 
              parentTicketDoc.data.tecnicoAsignadoId == request.auth.uid ||
              (parentTicketDoc.data.clientId != null && parentTicketDoc.data.clientId == getUserClientId()) ||
              (parentTicketDoc.data.locationId != null && parentTicketDoc.data.locationId in getAssignedLocations()) ||
              (parentTicketDoc.data.villaId != null && parentTicketDoc.data.villaId in getAssignedLocations())
            )
          )
        );
        allow create, update: if isManager() || (isAuth() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.technicianId == request.auth.uid || 
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.tecnicoAsignadoId == request.auth.uid
        ));
        allow delete: if isManager();
      }
    }
    
    // Eventos e Historial de Tickets (Timeline/Auditoría)
    match /ticketEvents/{eventId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isManager();
    }

    match /auditLogs/{logId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isManager();
    }
    
    // 5) COMPRAS EN CALLE
    // Técnicos registran compras, pero solo gerentes pueden listarlas de forma global o eliminarlas
    match /purchases/{purchaseId} {
      allow read: if isManager() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isManager() || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isManager();
    }

    // Historial y Control de Kilometraje de Vehículos
    match /vehicleMileageLogs/{logId} {
      allow read: if isAuth();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }

    // 6) PROYECTOS Y ZONAS (Acceso restringido por asignación de técnicos)
    match /projects/{projectId} {
      allow read: if isAuth() && (
        isManager() || 
        (resource != null && resource.data.assignedTechnicianIds != null && resource.data.assignedTechnicianIds.hasAny([request.auth.uid]))
      );
      allow write: if isManager();
    }
    
    match /projectZones/{zoneId} {
      allow read: if isAuth() && (
        isManager() || 
        (resource != null && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.assignedTechnicianIds.hasAny([request.auth.uid]))
      );
      allow write: if isAuth() && (
        isManager() || 
        (resource != null && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.assignedTechnicianIds.hasAny([request.auth.uid]))
      );
    }
    
    // 7) FALLBACK SEGURO PARA OTRAS COLECCIONES
    // Reglas para ubicaciones, equipos e intervenciones específicas de gestores
    match /locations/{locationId} {
      allow read: if isAuth() && (isManager() || locationId in getAssignedLocations());
      allow write: if isManager();
    }

    match /equipment/{equipmentId} {
      allow read: if isAuth() && (
        isManager() || 
        (resource != null && (resource.data.locationId in getAssignedLocations() || resource.data.villaId in getAssignedLocations()))
      );
      allow write: if isManager();
    }

    match /interventions/{interventionId} {
      allow read: if isAuth() && (
        isManager() || 
        (resource != null && resource.data.locationId in getAssignedLocations())
      );
      allow write: if isManager() || isAuth();
    }

    match /{colId}/{docId} {
      allow read: if isAuth() && colId != 'users' && colId != 'personnel' && colId != 'locations' && colId != 'equipment' && colId != 'interventions';
      allow write: if isManager() && colId != 'users' && colId != 'personnel' && colId != 'locations' && colId != 'equipment' && colId != 'interventions';
      
      match /{document=**} {
        allow read: if isAuth() && colId != 'users' && colId != 'personnel' && colId != 'locations' && colId != 'equipment' && colId != 'interventions';
        allow write: if isManager() && colId != 'users' && colId != 'personnel' && colId != 'locations' && colId != 'equipment' && colId != 'interventions';
      }
    }
  }
}
